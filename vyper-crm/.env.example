# ==========================================================
#  Vyper CRM — copie para .env e preencha
#  Gere segredos com:  openssl rand -hex 32
#  Em produção o CRM NÃO sobe enquanto houver valores começando com "troque".
# ==========================================================

# ---- Acesso ao painel ----
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@crm.local
# Senha do primeiro acesso (mín. 8 caracteres). Só é usada quando o banco ainda não tem usuários.
ADMIN_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---- IA ----
# Configuração recomendada:
#   - AI_PROVIDER=openrouter + OPENROUTER_API_KEY: modelos gratuitos para o dia a dia (respostas do bot,
#     qualificação, copiloto, captador, follow-ups);
#   - CLAUDE_CODE_ENABLED=true: a sua assinatura do Claude (Pro/Max) só para a prospecção com IA e as
#     amostras (site demo / arte) dos leads quentes — veja "Claude Code" abaixo.
# Outras opções: anthropic (Claude pela API, pago), auto (Claude se tiver ANTHROPIC_API_KEY, senão OpenRouter)
# e claude-code (a assinatura responde tudo — gasta o limite do plano bem mais rápido).
# Com duas chaves, a de AI_PROVIDER é a principal e a outra vira reserva.
AI_PROVIDER=openrouter

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo usado pelo bot, copiloto e captador. Para gastar menos, experimente claude-sonnet-5-5 ou claude-haiku-5-5
AI_MODEL=claude-opus-5-5

# OpenRouter — https://openrouter.ai/keys (modelos gratuitos: até 20 pedidos/min e 50/dia; veja o README)
OPENROUTER_API_KEY=
# openrouter/free = escolhe entre os modelos gratuitos disponíveis. Também dá para fixar um, ex.:
# nvidia/nemotron-3-super-120b-a12b:free  (ou um pago, ex.: anthropic/claude-sonnet-5-5)
OPENROUTER_MODEL=openrouter/free
# Opcional: outros modelos, separados por vírgula, que o OpenRouter tenta se o principal falhar
OPENROUTER_FALLBACK_MODELS=

# Claude Code — a sua assinatura do Claude, sem chave de API. Com CLAUDE_CODE_ENABLED=true ele faz só a
# prospecção com IA (pesquisa na web) e as amostras: quando um lead fica quente ou é passado para você,
# o Claude cria um site demo (publicado no Netlify, veja abaixo) ou uma arte (imagem PNG) para esse lead,
# e você revisa e envia com 1 clique (nada sai sozinho). Conta nos limites do seu plano (janela de 5 horas
# e semanal); quando o limite acaba, o painel mostra a hora em que ele libera.
# No computador: instale (npm install -g @anthropic-ai/claude-code), rode "claude" e faça /login.
# No Docker: rode "claude setup-token" no seu computador e cole o token em CLAUDE_CODE_OAUTH_TOKEN.
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_OAUTH_TOKEN=
# Modelo: sonnet (padrão), opus (gasta o limite bem mais rápido) ou haiku (mais leve)
CLAUDE_CODE_MODEL=sonnet
# Modelo da prospecção na web (vazio = o mesmo de CLAUDE_CODE_MODEL)
CLAUDE_CODE_RESEARCH_MODEL=
# Modelo das amostras — site demo e arte (vazio = o mesmo de CLAUDE_CODE_MODEL)
CLAUDE_CODE_SAMPLE_MODEL=
# Caminho do executável, se não for achado sozinho (no Windows, o claude.exe — não o claude.cmd)
CLAUDE_CODE_PATH=
# Tempo máximo de cada resposta (ms) e quantas rodam ao mesmo tempo (só com AI_PROVIDER=claude-code;
# prospecção e amostras têm limites e vagas próprias)
CLAUDE_CODE_TIMEOUT_MS=180000
CLAUDE_CODE_MAX_CONCURRENCY=2

# Netlify — publica os sites demo das amostras (o lead recebe um link). Vazio = não publica (a arte em imagem
# continua funcionando). Token: app.netlify.com/user/applications → Personal access tokens.
NETLIFY_AUTH_TOKEN=
# Opcional: id do site onde os demos ficam. Vazio = o CRM cria um "vyper-demos-..." na primeira publicação.
# Os demos não aparecem em buscadores (robots.txt bloqueia e cada página tem noindex).
NETLIFY_SITE_ID=

# ---- WhatsApp ----
# simulator = teste sem WhatsApp | evolution = QR code (vem no docker-compose) | meta = API oficial
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_KEY=troque-por-uma-chave-da-evolution
EVOLUTION_INSTANCE=crm
# Token que protege a URL de webhook que a Evolution chama
WEBHOOK_SECRET=troque-por-um-token-de-webhook

# API oficial da Meta (só se WHATSAPP_PROVIDER=meta)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ---- n8n ----
# Chave que o n8n usa para chamar a API do CRM (header x-api-key)
CRM_API_KEY=troque-por-uma-chave-para-o-n8n
# Chave de criptografia das credenciais do n8n (não perca!)
N8N_ENCRYPTION_KEY=troque-por-outra-chave-aleatoria
# Opcional: assina os eventos enviados ao n8n (header x-crm-signature)
N8N_WEBHOOK_SECRET=

# ---- Geral ----
APP_TIMEZONE=America/Sao_Paulo
# Atrás de um proxy com HTTPS (Caddy, Nginx, Traefik) na própria VPS: TRUST_PROXY=1 e publique o CRM
# e o n8n só para o proxy (CRM_PUBLISH=127.0.0.1:3000, N8N_PUBLISH=127.0.0.1:5678). Sem isso, quem acessa
# a porta 3000 direto poderia forjar o próprio IP. Acessando o CRM direto (sem proxy), deixe false.
TRUST_PROXY=false
# CRM_PUBLISH=127.0.0.1:3000
# N8N_PUBLISH=127.0.0.1:5678
POSTGRES_USER=crm
POSTGRES_PASSWORD=troque-a-senha-do-banco

# ---- Só para rodar SEM Docker (npm run dev) ----
# DATABASE_URL=pglite://./data/pglite
# PUBLIC_URL=http://localhost:3000
# EVOLUTION_API_URL=http://localhost:8080
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/crm-eventos
