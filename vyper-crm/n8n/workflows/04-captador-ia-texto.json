      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Troque crmApiKey pela CRM_API_KEY do seu .env. Se o n8n não estiver no mesmo docker-compose, troque crmUrl pelo endereço do CRM.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.crmUrl }}/api/integrations/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Configuração').first().json.crmApiKey }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  rawText: $json.body.texto ?? $json.body.text,\n  source: $json.body.origem ?? 'captador-ia',\n  qualify: true\n}) }}"
      },
